# Staging / dev — dev.artipascher.fr → port 3002
# Copier : sudo cp deploy/nginx-staging.conf.example /etc/nginx/sites-available/artipascher-dev
#          sudo ln -sf /etc/nginx/sites-available/artipascher-dev /etc/nginx/sites-enabled/
#          sudo nginx -t && sudo systemctl reload nginx
# Puis : sudo certbot --nginx -d dev.artipascher.fr

server {
    listen 80;
    server_name dev.artipascher.fr;

    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
