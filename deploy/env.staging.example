# Copier vers /var/www/artipascher-dev/.env.local au premier setup.
# Ne pas activer SMS / Stripe prod / Places sur le staging.

ADMIN_PASSWORD=changez-moi@

# Généré au setup : même valeur que la prod + « @ » en suffixe.

NEXT_PUBLIC_SITE_URL=https://dev.artipascher.fr
# Staging : pas de bordereau bêta, inscriptions / demandes / paiements demo ouverts
NEXT_PUBLIC_BETA_MODE=false
NEXT_PUBLIC_ARTIPASCHER_STAGING=1
ARTIPASCHER_STAGING=1
BETA_MODE=false

# Stripe test uniquement (clés sk_test / pk_test dans .env.local VPS)
PAYMENT_MODE=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Pas de Google Places ni crons staging
GOOGLE_PLACES_ENABLED=false

# OVH SMS désactivé (évite envoi accidentel)
OVH_SMS_ENABLED=false

# Optionnel : secret cron distinct si vous testez les crons manuellement
# CRON_SECRET=
