ADMIN_PASSWORD=artipascher2026

# Version bêta / préouverture (activée par défaut).
# Les inscriptions, demandes et paiements sont bloqués tant que ce n'est pas "false".
# NEXT_PUBLIC_BETA_MODE=false

# URL publique du site (obligatoire en production — partage, Open Graph, liens absolus)
NEXT_PUBLIC_SITE_URL=https://nord-artisan-pro.com

# Google Analytics (gtag) — chargé en production
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-S1NP0RF6Y4
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18373726951
# NEXT_PUBLIC_GA_DEBUG=true  # forcer le chargement en local
# Search Console — balise HTML (code collé depuis Google, sans les guillemets)
# GOOGLE_SITE_VERIFICATION=

# Connexion Google (particuliers + artisans)
# Console Google Cloud → API et services → Identifiants → ID client OAuth (application Web)
# URI de redirection autorisés (un par environnement) :
#   http://localhost:3010/api/auth/google/callback
#   https://nord-artisan-pro.com/api/auth/google/callback
#   https://dev.nord-artisan-pro.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email — contact@ = boîte humaine ; noreply@ = envoi technique du site (SMTP OVH)
# SMTP OVH MX Plan : uniquement transactionnel (reset MDP, confirmation). PAS de mailing.
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=587
# SMTP_USER=noreply@nord-artisan-pro.com
# SMTP_PASS=
# EMAIL_FROM=Nord Artisan Pro <noreply@nord-artisan-pro.com>
# (Mentions légales / contact public : contact@nord-artisan-pro.com — voir brand.ts)

# Marketing (mails de masse + repli SMS) — Brevo, pas OVH MX Plan
# 1) Compte https://app.brevo.com/  2) Authentifier nord-artisan-pro.com (SPF/DKIM)
# 3) Clé API + expéditeur SMS alphanumérique (max 11 car.)
# BREVO_API_KEY=
# BREVO_EMAIL_SENDER=contact@nord-artisan-pro.com
# BREVO_EMAIL_SENDER_NAME=Nord Artisan Pro
# BREVO_SMS_SENDER=NordArtPro
# EMAIL_UNSUBSCRIBE_SECRET=
# Alternative SMTP marketing (ex. smtp-relay.brevo.com) si pas d'API :
# MARKETING_SMTP_HOST=
# MARKETING_SMTP_PORT=587
# MARKETING_SMTP_USER=
# MARKETING_SMTP_PASS=

# Production VPS : PAYMENT_MODE=stripe + clés Stripe réelles
# PAYMENT_MODE=demo

# Bandeau « places de contact encore disponibles » sur les enchères (défaut: affiché).
# NEXT_PUBLIC_CONTACT_SLOTS_BANNER=false

# Rayon de recherche entreprises (km) — SMS / production Places
# NEARBY_BUSINESS_RADIUS_KM=20

# Google Places — OPT-IN STRICT (défaut = off). À activer seulement en prod pour tester.
# Sans GOOGLE_PLACES_ENABLED=true : aucune requête Places (ni preview SMS, ni cron, ni bouton).
# GOOGLE_PLACES_ENABLED=true
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_MONTHLY_QUOTA=5000
# GOOGLE_PLACES_PAID_OVERAGE=false

# Cron VPS (Bearer) — deploy/cron-sirene-weekly.sh + cron-places-daily.sh
# CRON_SECRET=

# Classification métier depuis la description (optionnel). Sans clé : mots-clés seulement.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# SMS OVH — même service pour OTP client + alertes + campagnes (expéditeur unique).
# Conformité code : transactional = sans STOP ; marketing = STOP + lun–sam 8h–20h Paris.
# Alerte admin à chaque nouvelle demande client (vide = désactivé).
# ADMIN_SMS_PHONE=0699450912
# OVH_SMS_ENABLED=false
# OVH_APP_KEY=
# OVH_APP_SECRET=
# OVH_CONSUMER_KEY=
# OVH_SMS_SERVICE_NAME=sms-xx00000-1
# OVH_SMS_SENDER=NordArtPro

# Paiement déblocage coordonnées client (1 €)
# PAYMENT_MODE=demo
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
